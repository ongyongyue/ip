<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
        maxHeight="-Infinity" maxWidth="-Infinity"
        minHeight="-Infinity" minWidth="-Infinity"
        prefHeight="620.0" prefWidth="400.0"
        style="-fx-background-color: #ECE5DD;"
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="holiday.MainWindow">

    <children>

        <!-- ═══ HEADER BAR ═══ -->
        <HBox
                alignment="CENTER"
                prefHeight="56.0"
                style="-fx-background-color: #1F2C34;
                       -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0, 0, 3);"
                AnchorPane.topAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0">
            <padding>
                <Insets left="16.0" right="16.0" top="10.0" bottom="10.0" />
            </padding>
            <children>
                <Label text="Holiday Chat Bot"
                       style="-fx-font-family: 'Segoe UI Semibold';
                              -fx-font-size: 16px;
                              -fx-text-fill: #FFFFFF;
                              -fx-font-weight: bold;" />
            </children>
        </HBox>

        <!-- ═══ SCROLL PANE (chat area) ═══ -->
        <ScrollPane
                fx:id="scrollPane"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                hvalue="1.0" vvalue="1.0"
                fitToWidth="true"
                style="-fx-background: #ECE5DD;
                       -fx-background-color: #ECE5DD;
                       -fx-border-color: transparent;"
                AnchorPane.topAnchor="56.0"
                AnchorPane.bottomAnchor="62.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer"
                      spacing="4.0"
                      prefWidth="388.0"
                      style="-fx-background-color: #ECE5DD;">
                    <padding>
                        <Insets top="10.0" bottom="10.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>

        <!-- ═══ INPUT BAR ═══ -->
        <HBox
                alignment="CENTER"
                spacing="8.0"
                prefHeight="62.0"
                style="-fx-background-color: #F0F2F5;
                       -fx-border-color: #D9D9D9;
                       -fx-border-width: 1 0 0 0;"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0">
            <padding>
                <Insets left="12.0" right="12.0" top="10.0" bottom="10.0" />
            </padding>
            <children>
                <TextField
                        fx:id="userInput"
                        promptText="Message Holiday..."
                        onAction="#handleUserInput"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #FFFFFF;
                               -fx-background-radius: 22px;
                               -fx-border-radius: 22px;
                               -fx-border-color: transparent;
                               -fx-padding: 9 16 9 16;
                               -fx-font-family: 'Segoe UI';
                               -fx-font-size: 13.5px;
                               -fx-text-fill: #1A1A1A;
                               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 4, 0, 0, 1);" />

                <Button
                        fx:id="sendButton"
                        text="Send"
                        onAction="#handleUserInput"
                        minWidth="68.0"
                        prefHeight="38.0"
                        style="-fx-background-color: #005C4B;
                               -fx-background-radius: 22px;
                               -fx-border-radius: 22px;
                               -fx-text-fill: #FFFFFF;
                               -fx-font-family: 'Segoe UI Semibold';
                               -fx-font-size: 13px;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;" />
            </children>
        </HBox>

    </children>
</AnchorPane>
