<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<fx:root alignment="TOP_RIGHT"
         maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308"
         prefWidth="400.0"
         spacing="8.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets bottom="6.0" left="60.0" right="12.0" top="6.0" />
    </padding>

    <children>

        <!-- Spacer -->
        <Region HBox.hgrow="ALWAYS" />

        <!-- Bubble + timestamp (right-aligned) -->
        <VBox spacing="3.0" alignment="TOP_RIGHT">
            <children>
                <Label fx:id="dialog"
                       wrapText="true"
                       maxWidth="250.0"
                       minHeight="-Infinity"
                       style="-fx-background-color: #005C4B;
                              -fx-background-radius: 16 0 16 16;
                              -fx-padding: 10 14 10 14;
                              -fx-font-family: 'Segoe UI';
                              -fx-font-size: 13px;
                              -fx-text-fill: #FFFFFF;
                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);" />
                <Label fx:id="timestamp"
                       text="Just now"
                       style="-fx-font-family: 'Segoe UI';
                              -fx-font-size: 10px;
                              -fx-text-fill: #AAAAAA;
                              -fx-padding: 0 2 0 0;" />
            </children>
        </VBox>

        <!-- Square avatar, top-aligned -->
        <ImageView fx:id="displayPicture"
                   fitHeight="40.0" fitWidth="40.0"
                   pickOnBounds="true" preserveRatio="true"
                   style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 4, 0, 0, 1);" />

    </children>
</fx:root>
